{
  "name": "api-radar-backend",
  "version": "1.0.0",
  "description": "Backend API for APIRadar - Real-time API key leak monitoring",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "build:prod": "tsc --project tsconfig.prod.json",
    "start": "node dist/server.js",
    "backup": "ts-node src/scripts/backup-database.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "verify-token": "ts-node scripts/verifyToken.ts"
  },
  "keywords": [
    "api",
    "security",
    "monitoring",
    "fastify",
    "typescript"
  ],
  "author": "APIRadar Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/compress": "^6.5.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^9.1.0",
    "@fastify/rate-limit": "^8.1.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/jsonwebtoken": "^9.0.10",
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "bip32": "^5.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^16.3.1",
    "ecpair": "^3.0.1",
    "ethers": "^6.16.0",
    "fastify": "^4.29.1",
    "fastify-helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "tiny-secp256k1": "^2.2.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.33",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "ed25519-hd-key": "^1.3.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
